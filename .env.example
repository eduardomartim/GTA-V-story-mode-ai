# ───────── Database ─────────
# Postgres (Supabase or any Postgres with the pgvector extension).
# Leave empty to use the embedded PGlite database (real Postgres + pgvector in WASM)
# persisted in ./.data/pglite — zero-infra local development.
DATABASE_URL=
# TLS to Postgres: "require" = encrypted + certificate verified (recommended for Supabase/managed hosts).
# "no-verify" = encrypted but NOT verified (explicit, insecure opt-out). Empty = driver default.
DATABASE_SSL=
# Supabase keys are NOT used by this app (it talks to Postgres directly through DATABASE_URL).
# They are listed only so you never expose them: keep them server-side, never prefix a secret with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Chat model ─────────
# anthropic | openai | google | none   (none => clearly-labelled DEMO mode)
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional model overrides
AI_MODEL=

# ───────── Embeddings ─────────
# local | openai | google. "local" is a dependency-free hashed n-gram embedder (dev default).
# openai/google use 384-dim vectors so the schema never changes.
EMBEDDING_PROVIDER=local

# Public site URL (used for OpenGraph metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────── Security / ops ─────────
# Optional shared secret required in the `x-api-key` header of /api/chat and /api/search.
# Leave empty for an open public demo (rate limiting still applies).
API_ACCESS_KEY=
RATE_LIMIT_PER_MINUTE=20
# "true" enables verbose retrieval details in responses and logs (never enable in production).
DEBUG_MODE=
