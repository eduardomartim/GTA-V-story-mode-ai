{
  "name": "gta-v-story-ai",
  "version": "1.0.0",
  "private": true,
  "description": "A domain-specific AI knowledge agent for Grand Theft Auto V Story Mode",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run kb:validate && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "kb:build": "tsx scripts/dev/build-missions.ts && tsx scripts/dev/build-kb.ts && tsx scripts/dev/build-kb-2.ts && tsx scripts/dev/build-kb-3.ts && tsx scripts/dev/build-map.ts",
    "kb:validate": "tsx scripts/validate.ts",
    "kb:validate:links": "tsx scripts/validate.ts --check-links",
    "kb:ingest": "tsx scripts/ingest.ts",
    "eval": "tsx scripts/eval.ts",
    "ask": "tsx scripts/ask.ts",
    "audit:secrets": "tsx scripts/audit-secrets.ts",
    "explain": "tsx scripts/explain.ts",
    "db:validate": "tsx scripts/validate.ts",
    "evaluate": "tsx scripts/eval.ts",
    "kb:coverage": "tsx scripts/coverage.ts",
    "evaluate:retrieval": "tsx scripts/eval-retrieval.ts",
    "evaluate:llm": "tsx scripts/eval-llm.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "clsx": "^2.1.1",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
